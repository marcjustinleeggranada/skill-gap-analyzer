#!/bin/sh
# Refuses to push commits with the wrong identity or with attribution trailers.
# Turn on with: git config core.hooksPath .githooks
EXPECTED_NAME="Marc Justin Lee G. Granada"
EXPECTED_EMAIL="granadamarc96@gmail.com"
ZERO="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  for c in $(git rev-list $range); do
    ident=$(git log -1 --format='%an|%ae|%cn|%ce' "$c")
    expected="$EXPECTED_NAME|$EXPECTED_EMAIL|$EXPECTED_NAME|$EXPECTED_EMAIL"
    if [ "$ident" != "$expected" ]; then
      echo "Push blocked: commit $(git log -1 --format=%h "$c") has identity: $ident"
      echo "Expected: $expected"
      status=1
    fi
    if git log -1 --format=%B "$c" | grep -qiE '^(co-authored-by:|[a-z-]+-session:)|generated with'; then
      echo "Push blocked: commit $(git log -1 --format=%h "$c") has an attribution line in its message."
      status=1
    fi
  done
done

if [ "$status" -ne 0 ]; then
  echo "See docs/GIT_RULES.md. Fix with: git commit --amend --reset-author --no-edit"
fi
exit $status
